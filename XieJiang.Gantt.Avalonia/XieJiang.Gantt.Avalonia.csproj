<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Enables the trimming/AOT analyzers so the library stays usable in AOT-published apps -->
		<IsAotCompatible>true</IsAotCompatible>
		<!-- Compiled bindings are resolved at build time and do not need reflection -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>


	<ItemGroup>
		<AssemblyAttribute Include="Avalonia.Metadata.XmlnsDefinitionAttribute">
			<_Parameter1>https://github.com/xiejiang2014/XieJiang.Gantt.Avalonia</_Parameter1>
			<_Parameter2>XieJiang.Gantt.Avalonia</_Parameter2>
		</AssemblyAttribute>

		<AssemblyAttribute Include="Avalonia.Metadata.XmlnsDefinitionAttribute">
			<_Parameter1>https://github.com/xiejiang2014/XieJiang.Gantt.Avalonia</_Parameter1>
			<_Parameter2>XieJiang.Gantt.Avalonia.Controls</_Parameter2>
		</AssemblyAttribute>

		<AssemblyAttribute Include="Avalonia.Metadata.XmlnsPrefixAttribute">
			<_Parameter1>https://github.com/xiejiang2014/XieJiang.Gantt.Avalonia</_Parameter1>
			<_Parameter2>gantt</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup>
		<Title>XieJiang.Gantt.Avalonia</Title>
		<Authors>xiejiang</Authors>
		<Description>A Gantt chart control for Avalonia with task bars, dependencies, milestones and several date scales.</Description>
		<PackageTags>avalonia;gantt;chart;control</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/xiejiang2014/XieJiang.Gantt.Avalonia</PackageProjectUrl>
		<RepositoryUrl>https://github.com/xiejiang2014/XieJiang.Gantt.Avalonia.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="XieJiang.Gantt.Avalonia.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
	</ItemGroup>
</Project>